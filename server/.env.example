# ProductVerse AI - Server Environment Variable Template
# Copy this file to .env inside server/ root directory for local dev

# Running port
PORT=3001

# Node execution environment
NODE_ENV=production

# JSON Web Token Secret passphrase
JWT_SECRET=productverse-super-secret-key-2026-rc-phase-pass

# Neon PostgreSQL Cluster Connection URL
# Format: postgresql://[user]:[password]@[neon-domain]/[db-name]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:pass@ep-cool-butterfly-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# OpenAI API Key for AI Design Generator & Critic Reviews
OPENAI_API_KEY=sk-proj-placeholder-key-to-replace-with-actual-openai-auth

# Cloudinary Storage integration for photographed catalog downloads
# Copy connection string directly from Cloudinary console
CLOUDINARY_URL=cloudinary://123456789012345:api_secret_hash@my-cloud-name
