datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  avatar           String?
  role             Role              @default(USER)
  plan             Plan              @default(FREE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  projects         Project[]         @relation("ProjectOwner")
  teamMemberships  TeamMember[]
  versionsCreated  Version[]
  comments         Comment[]
  marketplaceItems MarketplaceItem[]
  notifications    Notification[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  likes            Like[]
}

model Project {
  id               String            @id @default(uuid())
  name             String
  description      String?
  modelUrl         String            // GLTF/GLB file path
  activeConfig     String            @default("{}") // Current active JSON material/mesh configuration
  ownerId          String
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  team             TeamMember[]
  versions         Version[]
  comments         Comment[]
  marketplace      MarketplaceItem?
}

model TeamMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("VIEWER") // VIEWER, EDITOR, OWNER
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Version {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  configData  String   // JSON string of config snapshot
  createdById String
  creator     User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Material {
  id             String   @id @default(uuid())
  name           String
  category       String   // e.g., Leather, Metal, Glass, Wood
  color          String   // hex code
  metalness      Float    @default(0.0)
  roughness      Float    @default(0.5)
  clearcoat      Float    @default(0.0)
  opacity        Float    @default(1.0)
  emissive       String   @default("#000000")
  normalScale    Float    @default(1.0)
  textureMapUrl  String?
  normalMapUrl   String?
  roughnessMapUrl String?
  createdAt      DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  // Spatial coordinates for R3F annotation pins
  posX      Float    @default(0)
  posY      Float    @default(0)
  posZ      Float    @default(0)
  isResolved Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MarketplaceItem {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  likes       Like[]
}

model Like {
  id        String          @id @default(uuid())
  itemId    String
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([itemId, userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String   // ACTIVE, CANCELED, PAST_DUE
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. USER_LOGIN, PROJECT_EDIT, VERSION_RESTORE
  details   String   // Text description
  ipAddress String?
  createdAt DateTime @default(now())
}
