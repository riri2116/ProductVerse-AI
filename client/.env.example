# ProductVerse AI - Client Environment Variable Template
# Copy this file to .env inside client/ root directory for local dev

# Base API endpoint pointing to Node.js backend server
VITE_API_URL=https://productverse-ai-backend.up.railway.app

# Realtime websocket namespace address (defaults to API endpoint)
VITE_WS_URL=https://productverse-ai-backend.up.railway.app
